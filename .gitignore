# --- backend (Python) ---
backend/.venv/
backend/data/
backend/.env
backend/__pycache__/
backend/**/__pycache__/
*.pyc
*.log
backend/tests/last_report.txt

# --- frontend (Node) ---
frontend/.env
frontend/.env.*
# ...but DO track the placeholder template, so a fresh clone knows what to configure.
!frontend/.env.example
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# --- Capacitor / Android native app (frontend/android is committed as source,
#     but Gradle build outputs, local machine config, and signing secrets are not) ---
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/capacitor-cordova-android-plugins/build/
frontend/android/local.properties
frontend/android/.idea/
frontend/android/app/src/main/assets/public/
frontend/android/app/src/main/assets/capacitor.config.json
frontend/android/app/src/main/assets/capacitor.plugins.json
frontend/*.keystore
frontend/*.jks
frontend/android/*.keystore
frontend/android/*.jks
# Release signing credentials (passwords + keystore path). NEVER commit — losing or leaking the
# keystore means the app can never be updated again. See android/keystore.properties.example.
frontend/android/keystore.properties
# Generated Play Store listing images (regenerable from public/logo.png)
frontend/store-assets/

# --- keep-alive pingers (deployed separately, not part of main app) ---
keep-alive/

# --- local-only admin dashboard (standalone, reads backend/.env; not part of the app) ---
dashboard.py
dashboard.html

# --- editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.GIT_INSTRUCTIONS.md
