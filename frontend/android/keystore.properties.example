# Release signing credentials for the Play Store build.
#
# Copy this file to `keystore.properties` (same folder) and fill in your real values.
# `keystore.properties` is GITIGNORED — never commit it, and never commit the .jks itself.
#
# ⚠️ THE KEYSTORE IS PERMANENT AND IRREPLACEABLE.
# Every update you ever publish must be signed with the SAME key. If you lose the .jks file or
# forget these passwords, you can NEVER update the app again — you would have to publish a new
# listing under a new package name and lose all users, installs and reviews.
# Back up the .jks file AND these passwords somewhere safe (password manager + offline copy).
#
# To create the keystore, use Android Studio:
#   Build → Generate Signed App Bundle / APK → Android App Bundle → Create new…
# (Doing it in the IDE keeps the passwords out of your shell history.)
#
# Or from a terminal, with Android Studio's bundled JDK:
#   "C:\Program Files\Android\Android Studio\jbr\bin\keytool" -genkeypair -v \
#     -keystore fluently-release.jks -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias fluently

# Path to the keystore, relative to frontend/android/ (keep the file in that folder).
storeFile=fluently-release.jks

# The keystore password you chose when creating it.
storePassword=CHANGE_ME

# The key alias inside the keystore (e.g. "fluently").
keyAlias=fluently

# The password for that key (often the same as storePassword).
keyPassword=CHANGE_ME
