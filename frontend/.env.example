# Backend API base URL — the frontend calls all endpoints from this.
# Local dev: http://localhost:8000 | Production: https://your-backend-domain.com
#
# ⚠️ THIS VALUE IS BAKED IN AT BUILD TIME (Vite), for the website AND for the Android app.
#
# ANDROID APP BUILDS (see CAPACITOR.md):
#  * RELEASE / Play Store build  -> must be the PUBLIC backend URL, e.g. https://api.fluently.fun
#    (a phone on mobile data can only reach a public HTTPS host).
#  * LOCAL on-device testing     -> keep http://localhost:8000 AND run
#        adb reverse tcp:8000 tcp:8000
#    which tunnels the PHONE's localhost:8000 to the backend on your dev machine. This is the
#    only way to test against a local backend, because inside the app "localhost" means the
#    phone itself — and Google rejects raw private IPs (10.x.x.x) as OAuth redirect URIs, so
#    pointing at your LAN IP would break login.
VITE_API_URL=http://localhost:8000

# Max characters allowed in a single TEXT chat message (voice mode is unlimited).
# Optional — defaults to 1200 (~200 words) if unset. Keeps the app conversation-shaped and
# protects the per-message judge / prompt size from huge pastes.
VITE_MAX_MESSAGE_CHARS=1200
